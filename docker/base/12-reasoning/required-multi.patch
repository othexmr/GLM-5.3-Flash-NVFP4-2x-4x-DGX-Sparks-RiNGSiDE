+def _completed_required_tools(text: str | None) -> list[dict]:
+    """Read complete tool objects from an unfinished JSON array.
+
+    Required tool arguments are emitted atomically per completed object. This
+    avoids partial-JSON repairs changing escapes or assigning an old object's
+    tail to a newly started array index when a delta crosses tool boundaries.
+    """
+    if not text:
+        return []
+    decoder = json.JSONDecoder()
+    pos = len(text) - len(text.lstrip())
+    if pos >= len(text) or text[pos] != "[":
+        return []
+    pos += 1
+    result = []
+    while True:
+        while pos < len(text) and text[pos].isspace():
+            pos += 1
+        if pos >= len(text) or text[pos] == "]":
+            return result
+        try:
+            obj, end = decoder.raw_decode(text, pos)
+        except json.JSONDecodeError:
+            return result
+        if not isinstance(obj, dict) or not isinstance(obj.get("name"), str):
+            return result
+        if "parameters" not in obj:
+            return result
+        result.append(obj)
+        pos = end
+        while pos < len(text) and text[pos].isspace():
+            pos += 1
+        if pos >= len(text) or text[pos] != ",":
+            return result
+        pos += 1
+
