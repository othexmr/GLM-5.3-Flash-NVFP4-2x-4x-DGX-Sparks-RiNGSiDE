+def resize(height: int, width: int, t: int = 2) -> tuple[int, int]:
+    return smart_resize(
+        t,
+        height,
+        width,
+        t_factor=2,
+        h_factor=FACTOR,
+        w_factor=FACTOR,
+        min_pixels=MIN_PIXELS,
+        max_pixels=MAX_PIXELS,
+    )
+
