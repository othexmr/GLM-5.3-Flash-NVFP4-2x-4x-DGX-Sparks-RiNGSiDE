+    else:  # plain_decode
+        B, next_n, blocks = 4, 1, [0, 1, 2, 3]
+        pos = torch.tensor([[5], [6], [7], [8]], dtype=torch.int32, device="cuda")
+        slot_map = torch.full((B, next_n), -1, dtype=torch.int32, device="cuda")
