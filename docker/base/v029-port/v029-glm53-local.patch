+    decode_lens = torch.tensor([4, 4], dtype=torch.int64)
+    out = _decode_topk_seq_lens(positions, decode_lens, 8, 2, 4, requires_padding=False)
+    assert torch.equal(out, positions[:8].to(torch.int32) + 1)
