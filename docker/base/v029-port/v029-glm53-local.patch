+def _is_flashkda_supported(
+    head_dim: int,
+    dtype: torch.dtype,
+    lower_bound: float | None,
+) -> bool:
+    if not current_platform.is_cuda():
+        return False
+    capability = current_platform.get_device_capability()
+    return (
+        capability is not None
+        and capability.major in (9, 10, 12)
+        and head_dim == 128
+        and dtype == torch.bfloat16
+        and lower_bound is not None
+    )
+
+
+def _is_b12x_kda_prefill_supported(
+    head_dim: int,
+    dtype: torch.dtype,
+    lower_bound: float | None,
+    state_dtype: torch.dtype,
+) -> bool:
+    """Return whether the add-only B12X KDA prefill op supports this layer."""
+    api = get_b12x_kda_prefill()
+    if api is None or not current_platform.is_cuda():
+        return False
+    return (
+        head_dim == 128
+        and dtype == torch.bfloat16
+        and state_dtype == torch.float32
+        and lower_bound is not None
+        and api.is_supported(torch.device(current_platform.current_device()))
+    )
+
+
+def _resolve_kda_prefill_backend(
+    backend: str,
+    head_dim: int,
+    dtype: torch.dtype,
+    lower_bound: float | None,
+    state_dtype: torch.dtype = torch.float32,
+) -> str:
+    if backend not in ("auto", "triton", "flashkda", "b12x"):
+        raise ValueError(f"Unsupported KDA prefill backend: {backend}")
+    # Preserve A59's policy: auto remains Triton and B12X is explicit opt-in.
+    if backend == "b12x":
+        if not _is_b12x_kda_prefill_supported(
+            head_dim, dtype, lower_bound, state_dtype
+        ):
+            raise RuntimeError(
+                "The b12x KDA prefill backend requires the hash-pinned B12X "
+                "overlay on a supported CUDA device, bfloat16 activations, "
+                "head_dim=128, float32 recurrent state, and a bounded KDA gate."
+            )
+        return "b12x"
+    # Keep GLM's existing auto policy; this candidate is explicit opt-in only.
+    if backend != "flashkda":
+        return "triton"
+    if not _is_flashkda_supported(head_dim, dtype, lower_bound):
+        raise RuntimeError(
+            "FlashKDA requires CUDA SM90/SM10x/SM12x, bfloat16, "
+            "head_dim=128, and a bounded KDA gate."
+        )
+    return "flashkda"
