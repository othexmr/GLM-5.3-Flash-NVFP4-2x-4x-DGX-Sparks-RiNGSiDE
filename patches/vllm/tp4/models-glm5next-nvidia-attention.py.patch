+def _glm53_chunked_mm_fp32(x: "torch.Tensor", weight: "torch.Tensor", rows: int) -> "torch.Tensor":
+    """x [M, K] BF16 @ weight [N, K].T -> [M, N] FP32, `rows` rows per cuBLAS call, one output buffer."""
+    m = x.shape[0]
+    out = torch.empty((m, weight.shape[0]), dtype=torch.float32, device=x.device)
+    wt = weight.T
+    for i in range(0, m, rows):
+        j = min(m, i + rows)
+        if not _GLM53_MM_OUT_OK:
+            try:
+                torch.mm(x[i:j], wt, out_dtype=torch.float32, out=out[i:j])
+                _GLM53_MM_OUT_OK.append(True)
+                continue
+            except (TypeError, RuntimeError):
+                _GLM53_MM_OUT_OK.append(False)
+        if _GLM53_MM_OUT_OK[0]:
+            torch.mm(x[i:j], wt, out_dtype=torch.float32, out=out[i:j])
+        else:
+            out[i:j].copy_(torch.mm(x[i:j], wt, out_dtype=torch.float32))
+    return out
+
