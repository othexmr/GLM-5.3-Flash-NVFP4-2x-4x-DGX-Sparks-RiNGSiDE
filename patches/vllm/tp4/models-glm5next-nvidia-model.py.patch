+def _glm53_embed_replicate_vote() -> str:
+    """GLM53_EMBED_REPLICATE, identical on every TP rank or a hard error (a mixed setting would hang a collective)."""
+    if _GLM53_EMBED_REPLICATE not in ("0", "1", "canon"):
+        raise RuntimeError("GLM53_EMBED_REPLICATE must be 0, 1 or canon")
+    from vllm.distributed import get_tp_group
+
+    group = get_tp_group()
+    votes = [None] * group.world_size
+    torch.distributed.all_gather_object(votes, _GLM53_EMBED_REPLICATE, group=group.cpu_group)
+    if any(v != _GLM53_EMBED_REPLICATE for v in votes):
+        raise RuntimeError(f"GLM53_EMBED_REPLICATE disagrees across TP ranks: {votes}")
+    return _GLM53_EMBED_REPLICATE
+
+
+def _glm53_mem_available_mib() -> int:
+    try:
+        with open("/proc/meminfo") as f:
+            for line in f:
+                if line.startswith("MemAvailable:"):
+                    return int(line.split()[1]) // 1024
+    except OSError:
+        pass
+    return -1
