+# Pool-width decode logits (ctx1m-topk, 2026-09-25; opt-in, default off).
+# The kpool indexer K cache keeps one entry per index_kpool tokens, and the decode
+# metadata divides seq_lens by the compression ratio, so a decode row never has
+# more than max_model_len // index_kpool valid scores. The decode paged-MQA
+# logits were still allocated max_model_len wide, and persistent_topk sizes its
+# CTA groups by the row stride: at max_model_len 1,048,576 a 5-8 row batch asked
+# for 90 co-resident CTAs on 48 SMs and the boot failed. With
+# GLM53_INDEXER_POOL_LOGITS=1 the decode logits (and the profiler's decode-logits
+# reservation) are cdiv(max_model_len, index_kpool) columns, rounded up to a
+# multiple of 1,024: 262,144 at 1M tokens. Upstream DeepSeek-V4 passes
+# max_model_len // compress_ratio to the same DeepGEMM kernel. Unset or 0 keeps
+# every path unchanged.
+_POOL_LOGITS_ENV = os.environ.get("GLM53_INDEXER_POOL_LOGITS", "").strip()
+if _POOL_LOGITS_ENV not in ("", "0", "1"):
+    raise ValueError("GLM53_INDEXER_POOL_LOGITS must be unset, 0 or 1")
+_POOL_LOGITS = _POOL_LOGITS_ENV == "1"
+_POOL_LOGITS_LOGGED = [False]
+
+# Prefill indexer row split (opt-in, default off). GLM53_INDEXER_ROW_SPLIT=1: in the prefill chunk loop every TP
+# rank scores only its share of a long chunk's query rows with the served kernels, and the ranks all-gather the
+# selected pool ids (int32, no floating-point collective); glm53_indexer_rowsplit.py has the rules. Unset or 0:
+# that module is never imported and every path is unchanged.
+_ROWSPLIT_ENV = os.environ.get("GLM53_INDEXER_ROW_SPLIT", "").strip()
+if _ROWSPLIT_ENV not in ("", "0", "1"):
+    raise ValueError("GLM53_INDEXER_ROW_SPLIT must be unset, 0 or 1")
+_ROWSPLIT_ON = _ROWSPLIT_ENV == "1"
+
+
+def _decode_logits_width(max_model_len: int, index_kpool: int) -> int:
+    """Columns of the decode paged-MQA logits.
+
+    max_model_len unless GLM53_INDEXER_POOL_LOGITS=1 and index_kpool > 1; then the
+    pool count cdiv(max_model_len, index_kpool), rounded up to a multiple of 1,024
+    (whole canonicalization tiles; a multiple of DeepGEMM's column split).
+    """
+    if not _POOL_LOGITS or index_kpool <= 1:
+        return max_model_len
+    pools = -(-max_model_len // index_kpool)
+    width = -(-pools // 1024) * 1024
+    if not _POOL_LOGITS_LOGGED[0]:
+        _POOL_LOGITS_LOGGED[0] = True
+        print(
+            f"GLM53_INDEXER_POOL_LOGITS engaged: decode logits {width} columns "
+            f"(max_model_len {max_model_len}, index_kpool {index_kpool})",
+            file=sys.stderr,
+            flush=True,
+        )
+    return width
+
