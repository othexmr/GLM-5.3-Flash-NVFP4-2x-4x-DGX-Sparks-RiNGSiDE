+def _exact_mask_row(
+    LOGITS_ROW,
+    tau,
+    n,
+    m,
+    MASK_VALUE: tl.constexpr,
+    VOCAB_SIZE: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr,
+    AUDIT: tl.constexpr,
