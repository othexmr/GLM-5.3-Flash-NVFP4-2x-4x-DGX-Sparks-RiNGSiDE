+    """Exact top-k cut of one row (k < number of finite logits): (tau, n) with n =
+    k - count(logit > tau) tokens kept at tau in vocab order."""
+    NUM_TILES: tl.constexpr = (VOCAB_SIZE + BLOCK_SIZE - 1) // BLOCK_SIZE
+    lo = tl.full((), float("-inf"), tl.float32)
+    hi = m
+    tau = m
+    n = tl.full((), 1, tl.int32)
+    done = tl.zeros((), dtype=tl.int32)
+    iters = tl.zeros((), dtype=tl.int32)
+    while done == 0:
+        t = _exact_pivot(lo, hi, min_x)
+        cnt = tl.zeros((), dtype=tl.int32)
+        minl = tl.full((), float("inf"), tl.float32)
+        cm = tl.zeros((), dtype=tl.int32)
+        for i in range(0, NUM_TILES):
+            offs = i * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
+            x = tl.load(LOGITS_ROW + offs, mask=offs < VOCAB_SIZE, other=-float("inf"))
+            above = (x > -float("inf")) & (x > t)
+            cnt += tl.sum(above.to(tl.int32))
+            xa = tl.where(above, x, float("inf"))
+            tmin = tl.min(xa)
+            tcnt = tl.sum((above & (xa == tmin)).to(tl.int32))
+            cm = tl.where(tmin < minl, tcnt, tl.where(tmin == minl, cm + tcnt, cm))
+            minl = tl.minimum(minl, tmin)
+        iters += 1
+        if ((cnt >= k) & (cnt - cm < k)) | (t == lo) | (iters >= 160):
+            tau = minl
+            n = tl.maximum(1, tl.minimum(k - (cnt - cm), cm))
+            done = tl.full((), 1, tl.int32)
+        elif cnt >= k:
+            lo = minl
+        else:
+            hi = t
+    if tau > m:
+        tau = m
+        n = tl.full((), 1, tl.int32)
+    return tau, n
