+    """Keeps every logit > tau and the first n (vocab order) equal to tau; the rest
+    becomes MASK_VALUE. Returns (kept exp-mass, total exp-mass, kept count) for AUDIT."""
+    NUM_TILES: tl.constexpr = (VOCAB_SIZE + BLOCK_SIZE - 1) // BLOCK_SIZE
+    rank = tl.zeros((), dtype=tl.int32)
+    kept_e = tl.zeros((), dtype=tl.float32)
+    all_e = tl.zeros((), dtype=tl.float32)
+    n_kept = tl.zeros((), dtype=tl.int32)
+    for i in range(0, NUM_TILES):
+        offs = i * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
+        msk = offs < VOCAB_SIZE
