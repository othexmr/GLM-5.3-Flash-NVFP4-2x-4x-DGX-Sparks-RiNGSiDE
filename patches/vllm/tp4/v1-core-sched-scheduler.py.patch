+def _glm53_ckpt_enable(scheduler) -> bool:
+    """kda-checkpoints: validate the geometry once at startup and share the plan table with every mamba manager.
+    GLM53_KDA_CKPT=1 on an unsupported geometry fails the boot instead of running silently without the feature."""
+    if _glm53_ckpt is None or not _glm53_ckpt.ENABLED:
+        return False
+    cache = scheduler.cache_config
+    mamba = [m for m in scheduler.kv_cache_manager.coordinator.single_type_managers
+             if isinstance(m.kv_cache_spec, MambaSpec)]
+    problems = []
+    if not scheduler.need_mamba_block_aligned_split:
+        problems.append("mamba cache mode is not align")
+    if not cache.enable_prefix_caching:
+        problems.append("prefix caching is off")
+    if getattr(cache, "prefix_cache_retention_interval", None) == 0:
+        problems.append("retention interval 0 (the split keeps the cache block grid)")
+    if scheduler.mamba_has_prefill_checkpoint_blocks:
+        problems.append("vLLM's own prefill checkpoint blocks are on")
+    if not mamba:
+        problems.append("no mamba group")
+    for m in mamba:
+        if m.block_size != scheduler.block_size:
+            problems.append(f"mamba block {m.block_size} != scheduler block {scheduler.block_size}")
+        if m.kv_cache_spec.num_prefill_checkpoint_blocks or m.num_speculative_blocks:
+            problems.append("mamba prefill-checkpoint or speculative blocks")
+        if not hasattr(m, "_glm53_ckpt_plans"):
+            problems.append("the mamba manager lacks the kda-checkpoints overlay")
+    if problems:
+        raise ValueError("GLM53_KDA_CKPT=1: " + "; ".join(sorted(set(problems))))
+    for m in mamba:
+        m._glm53_ckpt_plans = scheduler._glm53_ckpt_plans
+    logger.info("GLM53_KDA_CKPT scheduler on: block %d, at most %d exports per chunk, %d mamba groups",
+                scheduler.block_size, _glm53_ckpt.MAX_EXPORTS, len(mamba))
+    return True
+
+
+def _glm53_ckpt_attach(scheduler, scheduler_output, num_scheduled_tokens) -> None:
+    """kda-checkpoints: hand this pass's plans of scheduled requests to the workers, then clear the table."""
+    plans, counts = {}, scheduler._glm53_ckpt_counts
+    for rid, plan in scheduler._glm53_ckpt_plans.items():
+        start, end, _ = plan
+        if num_scheduled_tokens.get(rid) == end - start:
+            plans[rid] = plan
+        else:
+            counts["dropped"] += 1
+            if counts["dropped"] == 1:
+                logger.warning("GLM53_KDA_CKPT plan dropped: request %s scheduled %s of a planned [%d, %d)",
+                               rid, num_scheduled_tokens.get(rid), start, end)
+    scheduler._glm53_ckpt_plans.clear()
+    scheduler_output.glm53_kda_ckpt_plans = plans or None
+    for rid, (start, end, exports) in plans.items():
+        counts["plans"] += 1
+        n = counts["plans"]
+        if n <= 8 or n & (n - 1) == 0:
+            logger.info("GLM53_KDA_CKPT plan %d: request %s span [%d, %d) exports %s", n, rid, start, end,
+                        list(exports))
