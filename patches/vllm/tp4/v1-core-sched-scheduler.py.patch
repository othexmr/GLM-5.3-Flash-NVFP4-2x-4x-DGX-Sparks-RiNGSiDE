+def _prefix_retention_contract(scheduler):
+    # One host-side startup receipt; no scheduling, pool, or device mutation.
+    import os
+    if os.environ.get("GLM53_PREFIX_CACHE_CONTRACT") != "1":
+        return
+    import json
+    cache = scheduler.cache_config
+    coord = scheduler.kv_cache_manager.coordinator
+    logger.info("GLM53_PREFIX_CACHE_CONTRACT %s", json.dumps(dict(
+        schema=1, scheduler_block_size=scheduler.block_size,
+        hash_block_size=scheduler.hash_block_size,
+        effective_cache_block_size=cache.block_size,
+        retention_interval=cache.prefix_cache_retention_interval,
+        enable_prefix_caching=cache.enable_prefix_caching,
+        mamba_cache_mode=cache.mamba_cache_mode,
+        use_eagle=scheduler.use_eagle,
+        mamba_has_prefill_checkpoint_blocks=scheduler.mamba_has_prefill_checkpoint_blocks,
+        mamba_partial_cache_hit=scheduler.mamba_partial_cache_hit,
+        cache_hit_alignment_tokens=coord._cache_hit_alignment_tokens,
+        eagle_group_ids=sorted(coord.eagle_group_ids),
+        manager_block_sizes=[m.block_size for m in coord.single_type_managers],
+        max_num_scheduled_tokens=scheduler.max_num_scheduled_tokens), sort_keys=True))
+
