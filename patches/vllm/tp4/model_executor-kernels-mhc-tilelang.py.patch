+def _glm53_mhc_ppf_blocks(num_tokens, hc_hidden_size, n_sms, block_rows=None, split=None):
+    """(start, end, n_splits) of every row block of one blocked call: ceil(M / block_rows) blocks whose sizes differ
+    by at most one row, in row order."""
+    from vllm.model_executor.kernels.mhc.tilelang_kernels import compute_num_split
+    from vllm.utils.math_utils import cdiv
+
+    block_rows = _GLM53_MHC_PPF_BLOCK_ROWS if block_rows is None else block_rows
+    split = _GLM53_MHC_PPF_SPLIT if split is None else split
+    count = cdiv(num_tokens, block_rows)
+    base_rows, extra = divmod(num_tokens, count)
+    blocks, start = [], 0
+    for i in range(count):
+        rows = base_rows + (1 if i < extra else 0)
+        if split == "fill":
+            n_splits = max(1, n_sms // cdiv(rows, 128))
+        else:
+            n_splits = compute_num_split(64, hc_hidden_size, cdiv(rows, 64))
+        blocks.append((start, start + rows, n_splits))
+        start += rows
+    return blocks
+
