+async def _glm53_startup_prefill_warmup(engine_client: EngineClient) -> None:
+    """GLM53 startup prefill warm-up (outputs/2026-09-24-startup-warmup), default off.
+
+    GLM53_STARTUP_PREFILL_WARMUP=<count> runs <count> prompts of unique random token
+    ids (GLM53_STARTUP_PREFILL_WARMUP_TOKENS, default 28672), max_tokens 4 (so the
+    first decode and spec-decode verify steps run too; even prompts greedy, odd ones
+    with the model's default sampling), through the engine after init_app_state and
+    before the HTTP socket listens (v2: the stock renderer warm-up runs first, with
+    more free host memory), then resets the prefix cache, so no warm-up block stays
+    as a cache hit. The first large prefill chunks after boot run
+    2-6x slower than steady state on unified memory (outputs/2026-09-23-tp2-first-chunk);
+    this moves that cost before /health. One stderr marker here, and one per worker
+    (every rank) through collective_rpc.
+    """
+    import random
+    import sys
+    import time
+    import uuid
+
+    from vllm.sampling_params import RequestOutputKind, SamplingParams
+
+    count = int(os.environ.get("GLM53_STARTUP_PREFILL_WARMUP", "0") or 0)
+    if count <= 0:
+        return
+    # v3 (replay-boundary, 2026-09-24): GLM53_STARTUP_PREFILL_WARMUP_TOKENS may list prompt lengths ("28672,28672,
+    # 5120,..."), used in order and cycled over the <count> prompts, so a lever's own chunk row counts run before
+    # readiness (outputs/2026-09-24-replay-boundary/warmup_shapes.py). A single value behaves exactly as v2.
+    lengths = [
+        max(1, min(int(x), engine_client.model_config.max_model_len - 1))
+        for x in os.environ.get("GLM53_STARTUP_PREFILL_WARMUP_TOKENS", "28672").split(",")
+        if x.strip()
+    ] or [28672]
+    tokens = lengths[0] if len(lengths) == 1 else ",".join(str(n) for n in lengths)
+    version = 2 if len(lengths) == 1 else 3
+    # Ordinary text ids only: GLM-5.3's special and multimodal ids start at 154820.
+    high = min(engine_client.model_config.get_vocab_size(), 150000)
+    sampled = {
+        k: v
+        for k, v in engine_client.model_config.get_diff_sampling_param().items()
+        if k in ("temperature", "top_p", "top_k", "min_p")
+    }
+    if not sampled.get("temperature"):
+        sampled["temperature"] = 1.0
+    params = [
+        SamplingParams(
+            max_tokens=4,
+            detokenize=False,
+            output_kind=RequestOutputKind.FINAL_ONLY,
+            **({"temperature": 0.0} if i % 2 == 0 else sampled),
+        )
+        for i in range(2)
+    ]
+    print(
+        f"GLM53_STARTUP_WARMUP start v={version} n={count} tokens={tokens} max_tokens=4",
+        file=sys.stderr,
+        flush=True,
+    )
+    t_all, seconds, cached, finished, reset, error = time.monotonic(), [], [], 0, None, None
+    try:
+        for i in range(count):
+            rng = random.Random(f"{time.time_ns()}-{i}-{uuid.uuid4().hex}")
+            ids = [rng.randrange(1000, high) for _ in range(lengths[i % len(lengths)])]
+            request_id = f"glm53-startup-warmup-{i}-{uuid.uuid4().hex[:8]}"
+            t0, last = time.monotonic(), None
+            async for out in engine_client.generate(
