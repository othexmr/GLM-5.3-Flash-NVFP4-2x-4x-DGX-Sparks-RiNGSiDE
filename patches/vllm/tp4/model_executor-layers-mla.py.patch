+# GLM53_MLA_QNORM_FP8 (default "0" = the served code, unchanged): for prefill-sized calls (more than 128 rows) of an
+# MLA layer with q-LoRA and the fused q_a/kv_a RMSNorm, the norm kernel also writes the per-token FP8 quantization of
+# the normalized q_c (vllm/models/common/ops/glm53_qnorm_fp8.py: the served kernel's statements plus vLLM's
+# per-token quantization arithmetic) and registers it in the dense module's shared-quant slot as producer
+# "mla_qnorm". q_b_proj takes it (GLM53_DENSE_SHARED_QUANT=mla_qnorm>mla_qb,...) and relays it to the indexer's wq_b
+# (mla_qb>indexer), so the separate quantization kernel, which re-read the BF16 q_c, is gone. It engages only where
+# q_b_proj is certain to take the copy (glm53_consumes_shared_quant); otherwise the served kernel runs.
+#   1 = the BF16 q_c is still written (a reader that misses the slot quantizes it itself; logged once);
+#   2 = FP8 only: the BF16 q_c store is skipped when every reader of q_c takes the copy (q_b_proj and, if the indexer
+#       runs, its wq_b through the relay); after each reader the hit counter is checked and a miss raises. Where the
+#       indexer cannot take it, that call runs mode 1.
+_GLM53_MLA_QNORM_FP8_RAW = os.environ.get("GLM53_MLA_QNORM_FP8", "0").strip()
+if _GLM53_MLA_QNORM_FP8_RAW not in ("0", "1", "2"):
+    raise ValueError(f"GLM53_MLA_QNORM_FP8 must be 0, 1 or 2, not {_GLM53_MLA_QNORM_FP8_RAW!r}")
+_GLM53_MLA_QNORM_FP8 = int(_GLM53_MLA_QNORM_FP8_RAW)
+_GLM53_QNORM_PRODUCER = "mla_qnorm"
+_GLM53_QNORM_MIN_ROWS = 128
+_GLM53_QNORM_LOGGED: set = set()
+if _GLM53_MLA_QNORM_FP8:
+    logger.warning("GLM53_MLA_QNORM_FP8_READY mode=%d default_off=1", _GLM53_MLA_QNORM_FP8)
+
+
+def _glm53_dense():
+    from vllm.model_executor.layers.quantization import glm53_dual_fp8_dense
+
+    return glm53_dual_fp8_dense
+
+
+class _Glm53QNorm:
+    """One engaged q_a norm: the q_b_proj input and normalized kv_c it returns, and the hand-over checks."""
+
+    __slots__ = ("q_proj_input", "kv_c_normed", "fp8_only", "indexer_takes", "hits")
+
+    def __init__(self, q_proj_input, kv_c_normed, fp8_only, indexer_takes, hits):
+        self.q_proj_input, self.kv_c_normed = q_proj_input, kv_c_normed
+        self.fp8_only, self.indexer_takes, self.hits = fp8_only, indexer_takes, hits
+
+    def check(self, reader: str) -> None:
+        """After q_b_proj ("q_b_proj", producer mla_qnorm) or the indexer ("indexer", the relay from mla_qb): the reader
+        took the handed quantization exactly once. A miss raises in FP8-only mode (the BF16 q_c was never written) and
+        is logged once otherwise (the reader quantized the served BF16 values itself)."""
+        if reader == "indexer" and not self.indexer_takes:
+            return
+        producer = _GLM53_QNORM_PRODUCER if reader == "q_b_proj" else "mla_qb"
+        got = _glm53_dense()._SHARED_QUANT_HITS.get(producer, 0)
+        if got == self.hits[producer] + 1:
+            self.hits[producer] = got
+            return
+        msg = (f"GLM53_MLA_QNORM_FP8: {reader} did not take the q_a norm's FP8 quantization "
+               f"(hits {got}, expected {self.hits[producer] + 1})")
+        if self.fp8_only:
+            raise RuntimeError(msg + "; FP8-only mode never wrote the BF16 q_c")
+        logger.warning_once(msg + "; the BF16 q_c is the served one, so its output is unchanged")
+
+
+def _glm53_mla_qnorm_fp8(wrapper, q_c: torch.Tensor, kv_c: torch.Tensor):
+    """GLM53_MLA_QNORM_FP8: the fused q_a/kv_a RMSNorm with q_b_proj's FP8 quantization fused in, registered for
+    q_b_proj, or None when this call keeps the served kernel (at most 128 rows, or q_b_proj would not take it)."""
+    m = q_c.shape[0]
+    if m <= _GLM53_QNORM_MIN_ROWS or q_c.dim() != 2 or q_c.dtype != torch.bfloat16:
+        return None
+    dense = _glm53_dense()
+    if not dense.glm53_consumes_shared_quant(wrapper.q_b_proj, m, _GLM53_QNORM_PRODUCER):
+        return None
+    runs_indexer = bool(wrapper.indexer) and wrapper.is_sparse and not wrapper.skip_topk
+    indexer_takes = (runs_indexer and wrapper.q_b_proj.quant_method.family in dense.SHARED_QUANT_PRODUCERS
+                     and dense.glm53_consumes_shared_quant(wrapper.indexer.wq_b, m, "mla_qb"))
+    fp8_only = _GLM53_MLA_QNORM_FP8 == 2 and (indexer_takes or not runs_indexer)
+    from vllm.models.common.ops.glm53_qnorm_fp8 import fused_q_kv_rmsnorm_fp8
+
+    q_out, kv_out, q8, q_scale = fused_q_kv_rmsnorm_fp8(
+        q_c,
+        kv_c,
+        wrapper.q_a_layernorm.weight.data,
+        wrapper.kv_a_layernorm.weight.data,
+        wrapper.q_a_layernorm.variance_epsilon,
+        write_q=not fp8_only,
+    )
+    hits = {p: dense._SHARED_QUANT_HITS.get(p, 0) for p in (_GLM53_QNORM_PRODUCER, "mla_qb")}
+    dense.glm53_register_quant(_GLM53_QNORM_PRODUCER, q_out, q8, q_scale)   # q_b_proj is the next dense apply()
+    key = (_GLM53_MLA_QNORM_FP8, fp8_only, indexer_takes)
+    if key not in _GLM53_QNORM_LOGGED:
+        _GLM53_QNORM_LOGGED.add(key)
+        logger.warning("GLM53_MLA_QNORM_FP8 engaged mode=%d fp8_only=%d indexer_takes=%d rows=%d",
+                       _GLM53_MLA_QNORM_FP8, int(fp8_only), int(indexer_takes), m)
+    return _Glm53QNorm(q_out, kv_out, fp8_only, indexer_takes, hits)
+
 
