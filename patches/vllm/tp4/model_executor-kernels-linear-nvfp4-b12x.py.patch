+# --- Row-chunked NVFP4 dense GEMM (dense-prefill lane 2026-09-24, default OFF) ------------------------------------
+# GLM53_NVFP4_DENSE_CHUNK_ROWS=<rows> runs the B12X NVFP4 dense GEMM in row chunks when M > rows (the GLM-5.3 lane:
+# the dense MLP of layers 0-2). At M > 256 the kernel keeps the 128x128 tile and its persistent scheduler walks M
+# first, so the packed activation is re-streamed once per 128-column N tile: in the cold 32K trace the 13,824-row
+# gate_up call takes 5.89 ms (118 TFLOPS) against 345 us for a 2,304-row call (336 TFLOPS), whose ~5 MB activation
+# stays in L2. The activation quantization uses the layer's static input global scale, so it is per row; each
+# chunk runs the same tile. GLM53_NVFP4_DENSE_CHUNK_MODE=out (default) writes every chunk into one caller-owned
+# output through b12x's dense_gemm (the serialized op's own operand views); =copy uses the public mm_nvfp4 and copies.
+# GLM53_NVFP4_DENSE_CHUNK_MIN_ROWS=<rows> (default 0): launches below it run as one call (their activation fits L2).
+logger = init_logger(__name__)
+_GLM53_NVFP4_CHUNK_ROWS = int(os.environ.get("GLM53_NVFP4_DENSE_CHUNK_ROWS", "0"))
+_GLM53_NVFP4_CHUNK_MIN_ROWS = int(os.environ.get("GLM53_NVFP4_DENSE_CHUNK_MIN_ROWS", "0"))
+_GLM53_NVFP4_CHUNK_MODE = os.environ.get("GLM53_NVFP4_DENSE_CHUNK_MODE", "out").strip().lower()
+if _GLM53_NVFP4_CHUNK_ROWS < 0 or (_GLM53_NVFP4_CHUNK_ROWS and _GLM53_NVFP4_CHUNK_ROWS % 128):
+    raise ValueError("GLM53_NVFP4_DENSE_CHUNK_ROWS must be 0 or a positive multiple of 128")
+if _GLM53_NVFP4_CHUNK_MODE not in ("out", "copy"):
+    raise ValueError("GLM53_NVFP4_DENSE_CHUNK_MODE must be out or copy")
