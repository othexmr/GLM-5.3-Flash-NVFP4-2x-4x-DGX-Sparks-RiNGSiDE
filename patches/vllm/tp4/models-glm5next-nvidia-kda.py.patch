+    rows = P.step()
+    if not rows or not any(rows):
+        return
+    if metadata_.num_prefills == 0:
+        # the managers allocated and hashed the export blocks: a planned step must export, never skip silently
+        raise RuntimeError("KDA checkpoint plans in a step without KDA prefill rows")
+    import glm53_kda_ckpt as KC
+
+    block_size = builder.kv_cache_spec.block_size
+    query_lens = m.query_start_loc_cpu.diff()
+    num_reqs = int(m.num_reqs)
+    if metadata_.num_spec_decodes == 0:
+        seq_rows = list(range(num_reqs))
+    else:
+        spec = num_decode_draft_tokens_cpu[:num_reqs] >= 0
+        if builder.use_recoverssm:
+            spec = spec | ((~m.is_prefilling[:num_reqs]) & (query_lens[:num_reqs] > 0))
+        seq_rows = [i for i in range(num_reqs) if not bool(spec[i]) and int(query_lens[i]) > 0]
+    planned = {i for i, plan in enumerate(rows) if plan is not None}
+    if not planned <= set(seq_rows):
+        raise RuntimeError(f"KDA checkpoint rows {sorted(planned - set(seq_rows))} are not prefill rows of the step")
