+def _glm_mark_contiguous_mixed(metadata_, common_attn_metadata, num_decode_draft_tokens_cpu, use_recoverssm) -> None:
+    """Builder hook: on a contiguous spec-verify + prefill step, store the two token starts on the metadata
+    (glm_spec_token_start / glm_non_spec_token_start). Counts mixed builds; logs the first fallback and the counts at
+    every power of two from 8 on (a 16-level campaign has about 43 mixed steps per rank)."""
+    is_prefilling = getattr(common_attn_metadata, "is_prefilling", None)
+    if not (
+        _CONTIGUOUS_MIXED
+        and metadata_.num_spec_decodes > 0
+        and metadata_.num_prefills > 0
+        and metadata_.num_decodes == 0
+        and metadata_.non_spec_token_indx is not None
+        and num_decode_draft_tokens_cpu is not None
+        and is_prefilling is not None
+    ):
+        return
+    spans = _glm_contiguous_mixed_spans(
+        common_attn_metadata.query_start_loc_cpu,
+        is_prefilling,
+        num_decode_draft_tokens_cpu,
+        metadata_.num_actual_tokens,
+        metadata_.num_spec_decode_tokens,
+        use_recoverssm,
+    )
+    counts = _CONTIGUOUS_MIXED_COUNTS
+    if spans is None:
+        counts["fallback"] += 1
+        if counts["fallback"] == 1:
+            _contiguous_mixed_logger.info(
+                "GLM53_KDA_CONTIGUOUS_MIXED fallback: first non-contiguous mixed step (%d spec + %d prefill "
+                "requests, %d tokens); it keeps the gather/merge path",
+                metadata_.num_spec_decodes,
+                metadata_.num_prefills,
+                metadata_.num_actual_tokens,
+            )
+    else:
+        counts["contiguous"] += 1
+        metadata_.glm_spec_token_start, metadata_.glm_non_spec_token_start = spans
+    total = counts["contiguous"] + counts["fallback"]
+    if total >= 8 and total & (total - 1) == 0:
+        _contiguous_mixed_logger.info(
+            "GLM53_KDA_CONTIGUOUS_MIXED mixed builds %d: contiguous %d, fallback %d",
+            total,
+            counts["contiguous"],
+            counts["fallback"],
+        )
