+# --- Contiguous mixed-batch KDA (vLLM v0.30 #56159 port; kda-mixed lane, 2026-09-24) --------------------------------
+# A mixed step (spec-verify rows + prefill rows) is split by the builder with a stable argsort; the forward then
+# gathers q|k|v, g1 and beta per group (six index_select), verifies into a fresh buffer and merges both outputs back
+# through a temporary (two index_copy_ and one copy). When the spec rows and the prefill rows each form one contiguous
+# token range (the V2 runner orders verify rows first), the builder hook below records both starts and the forward
+# takes slices instead: the verify writes into its core_attn_out slice and the prefill output is copied once into its
+# slice. Same kernels on the same values; the slices carry the merged projection's row stride, as pure steps already
+# do. Off unless GLM53_KDA_CONTIGUOUS_MIXED=1; non-contiguous mixed steps keep the gather/merge path.
+import os as _os
+
+from vllm.logger import init_logger as _init_logger
+
+_CONTIGUOUS_MIXED = _os.environ.get("GLM53_KDA_CONTIGUOUS_MIXED", "0") == "1"
+_contiguous_mixed_logger = _init_logger(__name__)
+_CONTIGUOUS_MIXED_COUNTS = {"contiguous": 0, "fallback": 0}
+_CONTIGUOUS_MIXED_ENGAGED_LOGGED = False
+
+
+def _glm_contiguous_mixed_spans(
+    query_start_loc_cpu: torch.Tensor,
+    is_prefilling_cpu: torch.Tensor,
+    num_decode_draft_tokens_cpu: torch.Tensor,
+    num_actual_tokens: int,
+    num_spec_decode_tokens: int,
+    use_recoverssm: bool,
+) -> tuple[int, int] | None:
+    """(spec_token_start, non_spec_token_start) if the spec rows and the other active rows each form one contiguous
+    token range, else None. The spec mask is KimiK3KDAMetadataBuilder.build's, from the same CPU inputs: rows with
+    drafts (num_decode_draft_tokens_cpu >= 0), under RecoverSSM OR every active non-prefilling row. Zero-length rows
+    carry no tokens and are skipped, as in v0.30's check."""
+    query_lens = query_start_loc_cpu.diff()
+    spec_mask = num_decode_draft_tokens_cpu >= 0
+    if use_recoverssm:
+        spec_mask = spec_mask | ((~is_prefilling_cpu) & (query_lens > 0))
+    active_spec = spec_mask[query_lens > 0]
+    if active_spec.numel() < 2 or int((active_spec[1:] != active_spec[:-1]).sum()) != 1:
+        return None
+    num_query_tokens = int(query_start_loc_cpu[-1])
+    num_spec_tokens = int(query_lens[spec_mask].sum())
+    # The two slices must cover exactly the rows the gather/merge path writes.
+    if num_query_tokens != num_actual_tokens or num_spec_tokens != num_spec_decode_tokens:
+        return None
+    if bool(active_spec[0]):
+        return 0, num_spec_tokens
+    return num_query_tokens - num_spec_tokens, 0
+
