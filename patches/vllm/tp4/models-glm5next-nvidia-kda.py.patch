+def _glm53_rule1_host_skip(builder, metadata_, common_attn_metadata) -> None:
+    """Fused-commit rule-1 host skip (outputs/2026-09-25-fused-commit-fix, patch A2). Rule 1 of the fused commit
+    (ops/recoverssm.py) commits at once every entry whose final position num_computed + c (c = accepted + 1, at most the
+    row's query length q) crosses its block end or ends within spec_query_len - 1 tokens of it. In a pure spec-decode
+    step (every active row verifies: request_indices is None and the entries are rows 0..n-1) the host knows every row's
+    num_computed and q, exactly under synchronous scheduling without adaptive verification (seq_lens_cpu_upper_bound and
+    query_start_loc_cpu are then precise). If num_computed % block_size + q <= block_size - spec_query_len for every
+    row, no entry of this step's commit can need rule 1, and the wrapper sets rule1_host_skip on the commit context for
+    this one commit: the commit then launches neither the split kernel nor the rule-1 commit. Every other step keeps
+    both launches."""
+    commit = getattr(metadata_, "recoverssm_commit", None)
+    context = getattr(metadata_, "recoverssm_context", None)
+    if commit is None or commit.align is None or commit.request_indices is not None:
+        return
+    if context is None or not getattr(context, "fused", False):
+        return
+    vllm_config = builder.vllm_config
+    if getattr(vllm_config.scheduler_config, "async_scheduling", None) is not False:
+        return
+    if getattr(vllm_config.speculative_config, "enable_adaptive_verification", False):
+        return
+    upper = common_attn_metadata.seq_lens_cpu_upper_bound
+    num_spec = int(metadata_.num_spec_decodes)
+    if upper is None or num_spec <= 0:
+        return
+    block_size = int(commit.align.block_size)
+    limit = block_size - int(context.spec_query_len)
+    qsl = common_attn_metadata.query_start_loc_cpu[: num_spec + 1].tolist()
+    seq_lens = upper[:num_spec].tolist()
+    for i in range(num_spec):
+        query_len = qsl[i + 1] - qsl[i]
+        if (seq_lens[i] - query_len) % block_size + query_len > limit:
+            return
+    commit_state = metadata_.commit_recoverssm_state
+
+    def commit_recoverssm_state(num_accepted_tokens):
+        context.rule1_host_skip = True
+        try:
+            return commit_state(num_accepted_tokens)
+        finally:
+            context.rule1_host_skip = False
+
+    metadata_.commit_recoverssm_state = commit_recoverssm_state
