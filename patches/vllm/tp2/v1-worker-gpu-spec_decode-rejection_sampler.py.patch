+    def _audit_verify(
+        self,
+        raw: torch.Tensor,
+        processed: torch.Tensor,
+        sampled: torch.Tensor,
+        num_sampled: torch.Tensor,
+        cu_num_logits: torch.Tensor,
+        pos: torch.Tensor,
+        idx_mapping_np: np.ndarray,
+        expanded_idx_mapping: torch.Tensor,
+    ) -> None:
+        """topp-fix audit: every token this verification emits (accepted drafts, then the
+        recovered or bonus token), against the distribution top-p was applied to."""
+        from vllm.v1.sample.ops import topk_topp_triton
+
+        s = self.sampler
+        ns = num_sampled.tolist()
+        cu = cu_num_logits.tolist()
+        ps = pos.tolist()
+        rows, flat, prov, ks, rids, poss = [], [], [], [], [], []
+        for r, n in enumerate(ns):
+            k = cu[r + 1] - cu[r] - 1
+            rid = s.req_states.index_to_req_id.get(int(idx_mapping_np[r]), "?")
+            for i in range(n):
+                rows.append(cu[r] + i)
+                flat.append(r * sampled.stride(0) + i)
+                prov.append("accepted" if i < n - 1 else ("bonus" if i == k else "recovered"))
+                ks.append(k)
+                rids.append(rid)
+                poss.append(ps[cu[r] + i])
+        if not rows:
+            return
+        dev = processed.device
+        top_k, top_p = s.sampling_states.get_top_k_top_p(
+            expanded_idx_mapping, idx_mapping_np
+        )
