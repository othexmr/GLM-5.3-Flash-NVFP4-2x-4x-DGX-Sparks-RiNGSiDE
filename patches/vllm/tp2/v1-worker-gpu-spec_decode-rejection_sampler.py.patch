+            processed=processed,
+            raw=raw,
+            rows=torch.tensor(rows, device=dev, dtype=torch.long),
+            tokens=sampled.reshape(-1)[torch.tensor(flat, device=dev, dtype=torch.long)].long(),
+            prov=prov,
+            ks=ks,
+            top_p=top_p,
+            backend=backend,
+            kernel_rec=(
+                getattr(topk_topp_triton, "LAST_AUDIT", [None])[0]
+                if backend == "triton"
+                else None
+            ),
+            guard_states=s._guard_states,
+            req_ids=rids,
+            positions=poss,
+        )
