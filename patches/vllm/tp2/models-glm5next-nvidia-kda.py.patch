+def _glm53_recoverssm_v1_column(metadata_) -> None:
+    """Exact-landing fix (outputs/2026-09-25-fused-commit-fix, section 4a), with ops/recoverssm.py's final column
+    cdiv(nc', block_size) - 1: after the commit, the image helper (v1/worker/gpu/model_states/recoverssm.py) sets the
+    running column to (num_computed + num_sampled) // block_size and the align postprocess copies from it. Handing it
+    num_computed - 1 makes that cdiv(nc', block_size) - 1, the column the commit wrote: on an exact landing the state
+    stays in the completed block and the next step's pre-copy moves it into the new one, which the scheduler allocates
+    only then. Off the boundary both formulas give the same column."""
+    commit = getattr(metadata_, "recoverssm_commit", None)
+    if commit is None or commit.align is None:
+        return
+    import dataclasses as _dc
+
+    helper_num_computed = commit.align.num_computed_tokens - 1
+    commit_state = metadata_.commit_recoverssm_state
+
+    def commit_recoverssm_state(num_accepted_tokens):
+        post = commit_state(num_accepted_tokens)
+        return None if post is None else _dc.replace(post, num_computed_tokens=helper_num_computed)
+
+    metadata_.commit_recoverssm_state = commit_recoverssm_state
+
