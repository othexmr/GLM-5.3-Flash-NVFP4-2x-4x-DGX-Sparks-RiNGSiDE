+def _kimi_k3_module(rel: str):
+    """Kimi-K3's RecoverSSM modules (``vllm/models/kimi_k3/nvidia/<rel>.py``), loaded by file path. Importing them
+    through their package would run ``vllm.models.kimi_k3.__init__``, which imports the whole Kimi model; both files
+    import only generic vLLM modules. (2026-09-23, GLM RecoverSSM port.)"""
+    import importlib.util
+    import sys
+    from pathlib import Path
+
+    import vllm.models
+
+    name = "vllm.models.glm5next.nvidia._kimi_k3_" + rel.replace("/", "_")
+    module = sys.modules.get(name)
+    if module is None:
+        path = Path(vllm.models.__file__).parent / "kimi_k3" / "nvidia" / f"{rel}.py"
+        spec = importlib.util.spec_from_file_location(name, path)
+        assert spec is not None and spec.loader is not None
+        module = importlib.util.module_from_spec(spec)
+        sys.modules[name] = module
+        spec.loader.exec_module(module)
+    return module
+
