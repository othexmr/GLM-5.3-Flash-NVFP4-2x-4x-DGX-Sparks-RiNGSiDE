+def _glm5next_recoverssm_backend():
+    """Kimi-K3's KDA metadata builder (RecoverSSM: one checkpoint slot per spec request, every active decode in the
+    spec group, accepted-state commit after sampling) with the commit context of GLM's RecoverSSM ops (records outside
+    the KV page, ``ops/recoverssm.py``) built from GLM's layers."""
+    global _GLM5NEXT_RECOVERSSM_BACKEND
+    if _GLM5NEXT_RECOVERSSM_BACKEND is not None:
+        return _GLM5NEXT_RECOVERSSM_BACKEND
+    from vllm.models.glm5next.nvidia.ops import recoverssm
+
+    metadata = _kimi_k3_module("kda_metadata")
+
+    class Glm5NextKDARecoverSSMMetadataBuilder(metadata.KimiK3KDAMetadataBuilder):
+        def __init__(self, kv_cache_spec, layer_names, vllm_config, device):
+            super().__init__(kv_cache_spec, layer_names, vllm_config, device)
+            # GDNAttentionMetadataBuilder.__init__ never calls the base __init__, the only place that stores
+            # layer_names, and the commit context needs them (campaign-1 boot: AttributeError at graph capture).
+            self.layer_names = list(layer_names)
+
+        def _get_recoverssm_context(self):
+            if self.recoverssm_context is None:
+                forward_context = self.vllm_config.compilation_config.static_forward_context
+                self.recoverssm_context = recoverssm.KDARecoverSSMCommitContext.create(
+                    [_Glm5NextRecoverSSMLayerView(forward_context[n]) for n in self.layer_names],
+                    spec_query_len=1 + self.vllm_config.num_speculative_tokens,
+                    max_num_reqs=self.vllm_config.scheduler_config.max_num_seqs,
+                )
+            return self.recoverssm_context
+
+        def build(self, common_prefix_len, common_attn_metadata, num_accepted_tokens=None,
+                  num_decode_draft_tokens_cpu=None, fast_build=False):
+            metadata_ = super().build(common_prefix_len, common_attn_metadata,
+                                      num_accepted_tokens=num_accepted_tokens,
+                                      num_decode_draft_tokens_cpu=num_decode_draft_tokens_cpu, fast_build=fast_build)
+            _glm53_recoverssm_v1_column(metadata_)
+            return metadata_
+
+    class Glm5NextKDARecoverSSMBackend(metadata.KimiK3KDAAttentionBackend):
+        @staticmethod
+        def get_name() -> str:
+            return "GLM5NEXT_KDA_RECOVERSSM"
+
+        @staticmethod
+        def get_builder_cls():
+            return Glm5NextKDARecoverSSMMetadataBuilder
+
+    _GLM5NEXT_RECOVERSSM_BACKEND = Glm5NextKDARecoverSSMBackend
+    return _GLM5NEXT_RECOVERSSM_BACKEND
