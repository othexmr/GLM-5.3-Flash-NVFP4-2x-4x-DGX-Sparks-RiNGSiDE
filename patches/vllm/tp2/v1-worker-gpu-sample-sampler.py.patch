+    def _audit_plain(self, raw, processed, sampled, input_batch, pos) -> None:
+        """topp-fix audit of the plain sampler (one row per request)."""
+        n = processed.shape[0]
+        idx_np = input_batch.idx_mapping_np
+        if n != len(idx_np):
+            return
+        from vllm.v1.sample.ops import topk_topp_triton
+
+        _, top_p = self.sampling_states.get_top_k_top_p(
+            input_batch.expanded_idx_mapping, idx_np
+        )
+        rec = (
+            getattr(topk_topp_triton, "LAST_AUDIT", [None])[0]
+            if self._audit_backend == "triton"
+            else None
+        )
+        self.audit.record(
+            pre=self._audit_pre if self._audit_pre is not None else processed,
+            processed=processed,
+            raw=raw,
+            rows=torch.arange(n, device=processed.device),
+            tokens=sampled.view(-1).long(),
+            prov=["plain"] * n,
+            ks=[0] * n,
+            top_p=top_p,
+            backend=self._audit_backend,
+            kernel_rec=rec,
+            guard_states=self._guard_states,
