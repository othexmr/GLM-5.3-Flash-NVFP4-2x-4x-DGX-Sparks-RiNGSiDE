+def kpool_tail_ring_size(index_kpool: int, num_speculative_tokens: int) -> int:
+    """Slots in each request's kpool tail ring (port of vllm-project/vllm#58454).
+
+    A verify step stashes all ``1 + num_speculative_tokens`` rows into the ring
+    before acceptance is known. When a pool-completing draft is rejected, the
+    next step redoes that completion from the open pool's committed keys, so
+    the rows stashed behind it must not have overwritten them. A ring of
+    ``index_kpool * cdiv(index_kpool + num_speculative_tokens, index_kpool)``
+    slots keeps them; without speculative decoding it is ``index_kpool``.
+    """
+    span = index_kpool + max(int(num_speculative_tokens), 0)
+    return index_kpool * -(-span // index_kpool)
+
+
