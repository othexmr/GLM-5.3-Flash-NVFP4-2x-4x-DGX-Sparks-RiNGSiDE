+    def configure_tile_major_b(self, *, intermediate_size: int, hidden_size: int) -> None:
+        """Enable the TP4 tile-major FC1/FC2 weight operands (default off).
+
+        The operands arrive as [tiles*128, 128, E] FP4 views whose every
+        (128-row, 128-element) TMA box is one contiguous 8 KB range, ordered
+        per intermediate slice as gate k-tiles, up k-tiles, then FC2 output
+        tiles -- the order the producer warp issues them.  Shared-memory
+        contents, scale operands, MMA and epilogue are unchanged.
+        """
+        if (
+            self.quant_recipe != "nvfp4"
+            or self.is_w4a8
+            or self.is_w6a8
+            or self.w4a8_repacked
+            or self.materialize_intermediate
+            or self.direct_routing
+            or self.swap_ab
+            or self.work_source != _WORK_SOURCE_MATERIALIZED_QUEUE
+        ):
+            raise ValueError(
+                "tile-major weights require the plain grouped NVFP4 dynamic kernel "
+                "on the materialized work queue"
+            )
+        n = int(intermediate_size)
+        k = int(hidden_size)
+        if self.tile_shape_mnk[1] != 128 or self.tile_shape_mnk[2] != 128:
+            raise ValueError("tile-major weights require 128x128 FP4 weight boxes")
+        if not self.is_gated:
+            raise ValueError("tile-major weights require the gated FC1")
+        if n % 128 != 0 or k % 128 != 0 or k % 256 != 0:
+            raise ValueError("tile-major weights require n % 128 == 0 and k % 256 == 0")
+        self.tile_major_b = True
+        self.tm_n = n
+        self.tm_k = k
+        self.tm_k_tiles = k // 128
+        self.tm_gate_tiles = n // 128
+        self.tm_out_tiles = k // 128
+        self.tm_w13_rows = 2 * n * k // 128
+        self.tm_w2_rows = k * n // 128
+
     def _thrfrg_SFA(self, sfa_tensor, tiled_mma):
         return self._dense_cls._thrfrg_SFA(self, sfa_tensor, tiled_mma)
 
