+def _tp4_tile_major_preparation_state(w1_fp4, w1_blockscale, w2_fp4, geometry):
+    """Return True for the same registered representation; reject mixed pairs.
+
+    Repeating the in-place preparation on already-packed storage would permute
+    the payload a second time (repeat-preparation defect found in the 2026-09-17
+    Pro review); the registry, not a flag, is the source of truth.  This guard
+    does not replace a model-owner teardown/generation protocol: one model
+    generation per worker; replace the worker on model replacement or a failed
+    partial conversion.  The existing strong-reference registry is unchanged.
+    """
+    key = (w1_fp4.data_ptr(), w2_fp4.data_ptr())
+    entry = _TP4_TILE_MAJOR_STORAGES.get(key)
+    if entry is not None:
+        if entry[0].as_dict() != geometry.as_dict():
+            raise ValueError("tile-major storage reused with a different geometry")
+        if tuple(w1_fp4.view(torch.uint8).shape) != (geometry.e, geometry.rows13, geometry.k // 2):
+            raise ValueError("registered tile-major W13 shape changed")
+        if tuple(w2_fp4.view(torch.uint8).shape) != (geometry.e, geometry.k, geometry.n // 2):
+            raise ValueError("registered tile-major W2 shape changed")
+        if not w1_fp4.is_contiguous() or not w2_fp4.is_contiguous():
+            raise ValueError("registered tile-major storage must remain contiguous")
+        normalized_key = (w1_fp4.data_ptr(), w1_blockscale.data_ptr())
+        if normalized_key not in _W13_NORMALIZED_STORAGES:
+            raise ValueError("registered tile-major W13 paired with unregistered scales")
+        return True
+    # Repacking just one member of an already-tile-major pair is also unsafe.
+    for registered_w1, registered_w2 in _TP4_TILE_MAJOR_STORAGES:
+        if key[0] == registered_w1 or key[1] == registered_w2:
+            raise ValueError("tile-major preparation received a mixed storage pair")
+    return False
+
