+        raise TypeError("experts must come from prepare_b12x_fp4_moe_weights")
+    plan = experts.plan
+    if not _tp4_tile_major_supported(plan):
+        raise ValueError("tile-major copy requires a single-recipe modelopt NVFP4 silu plan")
+    if experts.representation is not None:
+        raise ValueError("tile-major copy requires source-native expert weights")
+    n = int(plan.intermediate_size)
+    k = int(plan.hidden_size)
+    geometry = _tp4_tile_major_geometry(n=n, k=k, E=int(experts.w1_fp4.shape[0]))
+    if _tp4_tile_major_preparation_state(
+        experts.w1_fp4, experts.w1_blockscale, experts.w2_fp4, geometry
+    ):
+        raise ValueError("tile-major copy expects stock source storage, not a packed copy")
+    if plan.w13_layout == "w31":
+        _ensure_w13_kernel_order_inplace(
+            experts.w1_fp4, experts.w1_blockscale, n=n, k=k, quant_mode="nvfp4"
+        )
+    w1_u8 = experts.w1_fp4.view(torch.uint8)
+    w2_u8 = experts.w2_fp4.view(torch.uint8)
