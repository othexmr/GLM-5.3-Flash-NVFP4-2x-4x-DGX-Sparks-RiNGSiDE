+# GLM-5.3 lab (2026-09-24, moe-prefill-kernel): compile-time knob of the W4A4 NVFP4 prefill path. Read once at
+# import; the backend copies it at construction, and _impl.py appends a non-default value to the dynamic kernel's
+# compile key (memory and disk caches). The default leaves every build and every key byte-identical.
+#   B12X_GLM53_PREFILL_PREFETCH=d (1, 2 or 4): during FC2 of the 8-MMA-warp tiles, every MMA thread issues one
+#     `prefetch.global.L2` per output tile for the 128-byte line it will reduce into d tiles later (tile_m rows x
+#     two lines of the 256-byte row piece; the first d tiles are prefetched right after FC1). With routes that spread a
+#     token's experts in time, output rows have left L2 before each visit, so today every first reduction of a piece
+#     waits for a DRAM fill inside the L2 while the issuing MMA warps stall on the reduction queue. The prefetch moves
+#     that fill ahead of the reduction. Values are untouched (prefetch has no architectural effect).
+#     A trailing "a" (e.g. "2a") restricts the prefetch to the atomic accumulation (pure prefill); the deterministic
+#     path (mixed batches) is then built exactly as without the knob.
+_GLM53_PREFILL_PREFETCH = os.environ.get("B12X_GLM53_PREFILL_PREFETCH", "")
+if _GLM53_PREFILL_PREFETCH not in ("", "1", "2", "4", "1a", "2a", "4a"):
+    raise ValueError("B12X_GLM53_PREFILL_PREFETCH must be empty, 1, 2, 4, 1a, 2a or 4a")
+_GLM53_PREFILL_LOGGED: set = set()
+
+
