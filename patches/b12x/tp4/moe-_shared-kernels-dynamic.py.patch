+    if knobs and (tile_m, knobs) not in _GLM53_PREFILL_LOGGED:
+        import sys
+        print(f"GLM53_B12X_PREFILL_KNOBS tile_m={tile_m} {' '.join(f'{k}={v}' for k, v in knobs)} kernel built",
+              file=sys.stderr, flush=True)
+        _GLM53_PREFILL_LOGGED.add((tile_m, knobs))
+
+
+def _glm53_prefill_key() -> tuple:
+    """The non-default prefill knobs, as compile-key items (empty for the default build)."""
