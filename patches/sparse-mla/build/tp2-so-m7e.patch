+  const __nv_bfloat162 b23 = __floats2bfloat162_rn(f23.x * scale, f23.y * scale);
+  lo = *reinterpret_cast<const uint32_t*>(&b01);
+  hi = *reinterpret_cast<const uint32_t*>(&b23);
