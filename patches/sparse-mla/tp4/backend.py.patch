+def _glm53_prefix_split(prefilling: list, starts: list, num_actual_tokens: int) -> int:
+    """Pure-Python core of the mixed-step marker: prefilling[i] is request i's CPU scheduler phase, starts its
+    query_start_loc (n + 1 entries). Returns the token count of the leading non-prefilling requests when the batch
+    is exactly [non-prefilling requests][prefilling requests], both groups non-empty, every request carrying tokens
+    and the starts covering num_actual_tokens; -1 for any other batch mixing both phases; 0 for one phase."""
+    n = len(prefilling)
+    if n == 0 or len(starts) != n + 1:
+        return 0
+    decodes = sum(1 for p in prefilling if not p)
+    if decodes == 0 or decodes == n:
+        return 0
+    if any(prefilling[:decodes]):
+        return -1
+    if any(b <= a for a, b in zip(starts, starts[1:])) or starts[n] - starts[0] != num_actual_tokens:
+        return -1
+    return starts[decodes] - starts[0]
+
+
+def _glm53_decode_prefix_tokens(common: CommonAttentionMetadata) -> int:
+    """The mixed-step marker from CPU scheduler state only (is_prefilling, query_start_loc_cpu); absent or
+    device-resident inputs give 0, and the batch keeps its baseline MoE plan."""
+    flags = common.is_prefilling
+    starts = common.query_start_loc_cpu
+    n = common.num_reqs
+    if not (
+        flags is not None
+        and flags.device.type == "cpu"
+        and flags.dtype == torch.bool
+        and flags.ndim == 1
+        and 1 < n <= flags.numel()
+        and starts is not None
+        and starts.device.type == "cpu"
+        and starts.ndim == 1
+        and starts.numel() > n
+    ):
+        return 0
+    return _glm53_prefix_split(
+        flags[:n].tolist(), starts[: n + 1].tolist(), int(common.num_actual_tokens)
+    )
+
 
