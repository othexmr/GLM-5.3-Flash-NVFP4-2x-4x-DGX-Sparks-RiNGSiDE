diff --git a/src/transport/net_ib/connect.cc b/src/transport/net_ib/connect.cc
index e2c8ecb355689568895b8dc2d69a9d61c2dc0a92..7e803d5bd068582b4262c7a96a135f5097f31ef8 100644
--- a/src/transport/net_ib/connect.cc
+++ b/src/transport/net_ib/connect.cc
@@ -9,6 +9,7 @@
 #include "common.h"
 #include "p2p_resiliency.h"
 
+// Modified by switchless-nccl: bound switchless listener GID selection.
 NCCL_PARAM(IbGidIndex, "IB_GID_INDEX", -1);
 NCCL_PARAM(IbRoutableFlidIbGidIndex, "IB_ROUTABLE_FLID_GID_INDEX", 1);
 NCCL_PARAM(IbRoceVersionNum, "IB_ROCE_VERSION_NUM", 2);
@@ -22,6 +23,8 @@ NCCL_PARAM(IbFifoTc, "IB_FIFO_TC", -1);
 NCCL_PARAM(IbEceEnable, "IB_ECE_ENABLE", 1);
 
 extern int64_t ncclParamIbOooRq();
+extern int64_t ncclParamIbMergeNics();
+extern bool ncclSwitchlessRingOnly();
 
 struct ncclIbDevExtraProps {
   bool oooRq;
@@ -605,20 +608,64 @@ ncclResult_t ncclIbListen(void* ctx, int dev, void* opaqueHandle, void** listenC
   NCCLCHECKGOTO(ncclSocketListen(&comm->sock), ret, fail);
   NCCLCHECKGOTO(ncclSocketGetAddr(&comm->sock, &handle->connectAddr), ret, fail);
 
-  // Embed GIDs of all PFs in the handle so the connector can find a local NIC
-  // on the same subnet as any of our ports.
   if (ncclParamIbSubnetAwareRouting() && dev < ncclNMergedIbDevs) {
-    struct ncclIbMergedDev* mDev = ncclIbMergedDevs + dev;
-    int gidSlot = 0;
-    for (int i = 0; i < mDev->vProps.ndevs && gidSlot < 2; i++) {
-      int ibDevN = mDev->vProps.devs[i];
-      ncclIbDev* ibDev = ncclIbDevs + ibDevN;
-      if (ibDev->portAttr.link_layer != IBV_LINK_LAYER_ETHERNET) continue;
-      int gidIndex;
-      NCCLCHECKGOTO(ncclIbGetGidIndex(ibDev->context, ibDev->portNum, &ibDev->portAttr, &gidIndex), ret, fail);
-      NCCLCHECKGOTO(wrap_ibv_query_gid(ibDev->context, ibDev->portNum, gidIndex, &handle->listenGids[gidSlot]), ret,
-                    fail);
-      gidSlot++;
+    if (!ncclSwitchlessRingOnly()) {
+      // Preserve upstream behaviour unless switchless mode is explicit.
+      struct ncclIbMergedDev* mDev = ncclIbMergedDevs + dev;
+      int gidSlot = 0;
+      for (int i = 0; i < mDev->vProps.ndevs && gidSlot < 2; i++) {
+        int ibDevN = mDev->vProps.devs[i];
+        ncclIbDev* ibDev = ncclIbDevs + ibDevN;
+        if (ibDev->portAttr.link_layer != IBV_LINK_LAYER_ETHERNET) continue;
+        int gidIndex;
+        NCCLCHECKGOTO(ncclIbGetGidIndex(ibDev->context, ibDev->portNum, &ibDev->portAttr, &gidIndex), ret, fail);
+        NCCLCHECKGOTO(wrap_ibv_query_gid(ibDev->context, ibDev->portNum, gidIndex, &handle->listenGids[gidSlot]), ret,
+                      fail);
+        gidSlot++;
+      }
+    } else {
+      if (ncclParamIbMergeNics() != 0) {
+        WARN("SWITCHLESS/HARDENED: NCCL_IB_MERGE_NICS must be 0");
+        ret = ncclInvalidUsage;
+        goto fail;
+      }
+
+      int gidSlot = 0;
+      for (int devIdx = 0; devIdx < ncclNMergedIbDevs; devIdx++) {
+        struct ncclIbMergedDev* mDev = ncclIbMergedDevs + devIdx;
+        for (int i = 0; i < mDev->vProps.ndevs; i++) {
+          int ibDevN = mDev->vProps.devs[i];
+          ncclIbDev* ibDev = ncclIbDevs + ibDevN;
+          if (ibDev->portAttr.link_layer != IBV_LINK_LAYER_ETHERNET) continue;
+
+          int gidIndex;
+          union ibv_gid gid;
+          NCCLCHECKGOTO(ncclIbGetGidIndex(ibDev->context, ibDev->portNum, &ibDev->portAttr, &gidIndex), ret, fail);
+          NCCLCHECKGOTO(wrap_ibv_query_gid(ibDev->context, ibDev->portNum, gidIndex, &gid), ret, fail);
+          if (!validGid(&gid)) continue;
+          if (gidSlot > 0 && memcmp(&handle->listenGids[0], &gid, sizeof(gid)) == 0) {
+            WARN("SWITCHLESS/HARDENED: duplicate listener GID on IbDev %d Port %d", ibDevN, ibDev->portNum);
+            ret = ncclInvalidUsage;
+            goto fail;
+          }
+          if (gidSlot == 2) {
+            WARN("SWITCHLESS/HARDENED: more than two eligible listener GIDs");
+            ret = ncclInvalidUsage;
+            goto fail;
+          }
+
+          handle->listenGids[gidSlot] = gid;
+          INFO(NCCL_NET,
+               "SWITCHLESS/HARDENED: listener slot %d IbDev %d Port %d GID %d (%lX/%lX)", gidSlot, ibDevN,
+               ibDev->portNum, gidIndex, (uint64_t)gid.global.subnet_prefix, (uint64_t)gid.global.interface_id);
+          gidSlot++;
+        }
+      }
+      if (gidSlot != 2) {
+        WARN("SWITCHLESS/HARDENED: expected exactly two eligible listener GIDs, found %d", gidSlot);
+        ret = ncclInvalidUsage;
+        goto fail;
+      }
     }
   }
 
