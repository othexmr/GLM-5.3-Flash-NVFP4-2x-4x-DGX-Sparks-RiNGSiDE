+// Modified by switchless-nccl: strict opt-in and diagnostics.
 NCCL_PARAM(MultiSegmentRegister, "MULTI_SEGMENT_REGISTER", 1);
+NCCL_PARAM(SwitchlessRingOnly, "SWITCHLESS_RING_ONLY", 0);
+NCCL_PARAM(SkipTreeConnect, "SKIP_TREE_CONNECT", 0);
+
+bool ncclSwitchlessRingOnly() {
+  return ncclParamSwitchlessRingOnly() || ncclParamSkipTreeConnect();
+}
 
