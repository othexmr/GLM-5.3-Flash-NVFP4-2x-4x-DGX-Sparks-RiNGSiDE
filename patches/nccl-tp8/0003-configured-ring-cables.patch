@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <cassert>
+#include <cstdio>
+#include <initializer_list>
+#include "../../src/transport/net_ib/tp4_listener_contract.h"
+#include "../../src/transport/net_ib/ring_listener_contract.h"
+
+static const char* four = "10.100.224.0/24,10.100.225.0/24,10.100.226.0/24,10.100.227.0/24";
+static const char* eight = "10.100.224.0/24,10.100.225.0/24,10.100.226.0/24,10.100.227.0/24,10.100.228.0/24,10.100.229.0/24,10.100.230.0/24,10.100.231.0/24";
+
+int main() {
+  RingCableSubnets parsed;
+  assert(ringParseCableSubnets(four, &parsed) && parsed.count == 4);
+  assert(ringParseCableSubnets(eight, &parsed) && parsed.count == 8);
+  for (const char* bad : {"", "1", "1.2.3", "1.2.3.0/24,", "10.100.224.1/24",
+       "10.100.224.0/23", "10.100.024.0/24", "256.2.3.0/24", "10.100.224.0/24,,",
+       "10.100.224.0/24,10.100.224.0/24,10.100.225.0/24,10.100.226.0/24"})
+    assert(!ringParseCableSubnets(bad, &parsed));
+  assert(!ringParseCableSubnets(nullptr, &parsed));
+  char roots[4][11] = {"pci0000:00", "pci0000:00", "pci0001:00", "pci0001:00"};
+  uint8_t gids[4][16] = {};
+  for (int a = 220; a <= 234; ++a) for (int b = 220; b <= 234; ++b) {
+    for (int i = 0; i < 4; ++i) {
+      gids[i][10] = gids[i][11] = 255;
+      gids[i][12] = 10; gids[i][13] = 100; gids[i][14] = i % 2 ? b : a; gids[i][15] = i + 1;
+    }
+    assert((tp4ValidateListener(gids, roots, 4, true) == nullptr) ==
+           (ringValidateListener(gids, roots, 4, true, four) == nullptr));
+    bool valid = a != b && a >= 224 && a <= 231 && b >= 224 && b <= 231;
+    assert((ringValidateListener(gids, roots, 4, true, eight) == nullptr) == valid);
+  }
+  gids[0][14] = gids[2][14] = 224; gids[1][14] = gids[3][14] = 231;
+  assert(!ringValidateListener(gids, roots, 4, true, eight));
+  std::memcpy(gids[3], gids[1], 16);
+  assert(ringValidateListener(gids, roots, 4, true, eight));
+  assert(ringValidateListener(gids, roots, 5, true, eight));
+  std::puts("PASS: parser negatives, 225 TP4 parity cases and 225 eight-subnet membership cases");
+}
