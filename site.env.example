# Site file for launch/render.py. Copy to site-tp4.env / site-tp2.env (ignored by Git) and fill in your values.
# Addresses below use the documentation ranges (192.0.2.0/24); replace them. Nothing here is read by any node.

# --- Where things are on each node -------------------------------------------------------------------------------
SWITCHLESS_OVERLAY_ROOT=/srv/switchless/overlay-tp4     # built by sources/apply.py for this profile (and rank)
SWITCHLESS_MODEL_DIR=/srv/models/RedHatAI-GLM-5.3-Flash-NVFP4-18d55bfd
SWITCHLESS_TOKENIZER_FILE=/srv/models/nvidia-GLM-5.3-Flash-NVFP4-423acf37/tokenizer.json   # NVIDIA's tokenizer.json, mounted over the checkpoint's own
SWITCHLESS_DRAFTER_REPO_DIR=/srv/hf-cache/hub/models--incoai--GLM-5.3-Flash-DFlash2   # contains snapshots/7d74cdd8...
SWITCHLESS_HF_CACHE_DIR=/srv/switchless/cache           # mounted at /cache (HF_HOME=/cache/huggingface, offline)
SWITCHLESS_JIT_CACHE_ROOT=/srv/switchless/jit           # rank<N>/ below it is mounted at /root/.cache
SWITCHLESS_PROFILES_ROOT=/srv/switchless/profiles       # rank<N>/ below it is mounted at /profiles
SWITCHLESS_CONTAINER_PREFIX=switchless-tp4              # containers are named <prefix>-rank<N>
# SWITCHLESS_IMAGE=registry.example/glm53@sha256:...    # optional: the same image under a registry reference

# --- Bootstrap network (TP4: the management network; TP2: the fabric link, see fabric/README.md) ------------------
SWITCHLESS_RANK_HOST_IPS=192.0.2.10,192.0.2.11,192.0.2.12,192.0.2.13   # one per rank, in rank order (TP2: two)
SWITCHLESS_MASTER_ADDR=192.0.2.10                       # rank 0
SWITCHLESS_MASTER_PORT=25104
SWITCHLESS_API_PORT=8888
SWITCHLESS_SOCKET_IFNAME=enP7s7                         # the interface that carries the addresses above (TP2 measured: enp1s0f1np1)

# --- RoCE fabric -------------------------------------------------------------------------------------------------
# TP4: all four PCIe functions of both ports, exact match. TP2 measured: rocep1s0f1,roceP2p1s0f1
SWITCHLESS_IB_HCA==rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1
# TP4: must be 10.100.224.0/22 (the measured NCCL build accepts only the cable subnets 10.100.224-227.0/24).
# TP2 (stock NCCL): the subnet of the one cable, measured 10.100.224.0/24.
SWITCHLESS_FABRIC_CIDR=10.100.224.0/22

# --- Self-built image with Docker Compose (launch/compose.py, launch/up.sh, docker/README.md) --------------------
SWITCHLESS_REMOTE_REPO=/srv/switchless/recipe           # this repository's clone on every node, at the same path
# SWITCHLESS_SSH_TARGETS=admin@192.0.2.10,admin@192.0.2.11,admin@192.0.2.12,admin@192.0.2.13   # one per rank, in rank
#                                                       # order; default: SWITCHLESS_RANK_HOST_IPS
# SWITCHLESS_BUILD_IMAGE=glm53-switchless:tp4           # tag of the self-built profile image (default glm53-switchless:<profile>)
# SWITCHLESS_SHARE_TARGETS=-,PEER1,PEER2,PEER3          # optional, one per rank: the other nodes as rank 0's node reaches
#                                                       # them (for example over the fabric); unset: copied via this machine
# SWITCHLESS_API_HOST=192.0.2.10                        # optional: rank 0's address for clients (default: its ssh host)
